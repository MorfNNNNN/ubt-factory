# Domain serving both the API and the site with the privacy policy (DNS A records
# for it and www.<it> -> this host), e.g. familyapp1.ru
SHIELD_DOMAIN=example.ru
POSTGRES_PASSWORD=change-me-long-random

# Entitlement signing keys: docker compose run --rm server keygen
ENTITLEMENT_PRIVATE_KEY=
ENTITLEMENT_PUBLIC_KEY=

# RuStore Console -> API RuStore -> keys (RSA). Needed to verify purchases.
RUSTORE_KEY_ID=
RUSTORE_PRIVATE_KEY=
APP_PACKAGE_NAME=ru.ubt.familyshield

# RuStore Console -> Push notifications -> Projects
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_SERVICE_TOKEN=

# Optional daily block-list imports: CATEGORY=https://url;CATEGORY=https://url
# Check each list's licence before use (e.g. blocklistproject lists are Unlicense).
THREAT_FEEDS=

MESSAGE_RETENTION_DAYS=30
# Development only — never in production:
ALLOW_UNVERIFIED_PURCHASES=false
